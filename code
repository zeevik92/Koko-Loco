    function renderGrid(board, hitsGrid, winningSet = new Set(), explodingSet = new Set(), dropping = false) {
      const container = document.getElementById('slotGrid7x7');
      if (!container) return;
      container.innerHTML = '';

      let activeMultCells = 0;
      let maxMult = 1;

      for (let r = 0; r < 7; r++) {
        for (let c = 0; c < 7; c++) {
          const symId = board[r][c];
          const sym = SYMBOL_MAP[symId] || SYMBOLS[8];
          const hits = hitsGrid[r][c] || 0;
          const mult = getCellMultiplier(hits);
          if (mult > 1) {
            activeMultCells += 1;
            if (mult > maxMult) maxMult = mult;
          }

          const cell = document.createElement('div');
          const coordKey = `${r},${c}`;
          let tierClass = '';
          if (symId === 'S1_KOKO') tierClass = 'koko-mult-tile';
          else if (mult >= 16) tierClass = 'mult-tier-3';
          else if (mult >= 5) tierClass = 'mult-tier-2';
          else if (mult >= 2) tierClass = 'mult-tier-1';

          let animClass = '';
          if (explodingSet.has(coordKey)) animClass = 'cell-exploding';
          else if (winningSet.has(coordKey)) animClass = 'cell-winning';
          else if (dropping && !window.gsap) animClass = 'cell-dropping';

          cell.className = `slot-cell ${tierClass} ${animClass}`;
          if (!winningSet.has(coordKey) && symId !== 'S1_KOKO') {
            cell.style.boxShadow = `inset 0 1px 1px rgba(255,255,255,0.22), inset 0 0 12px ${sym.bgGlow}`;
          }
          cell.onclick = (ev) => {
            ev.stopPropagation();
            showSymbolTooltip(symId);
          };

          let badgeHtml = '';
          if (mult > 1) {
            badgeHtml = `<span class="mult-badge">${mult}x</span>`;
          }

          cell.innerHTML = `${sym.svg}${badgeHtml}`;
          container.appendChild(cell);
        }
      }

      // Priority 7 GSAP Choreography: Staggered 3D Spring Drop
      if (dropping && window.gsap) {
        const cells = container.querySelectorAll('.slot-cell');
        window.gsap.fromTo(cells,
          { y: -56, scaleY: 1.16, scaleX: 0.86, opacity: 0 },
          {
            y: 0,
            scaleY: 1,
            scaleX: 1,
            opacity: 1,
            duration: state.turbo ? 0.18 : 0.34,
            ease: 'back.out(1.65)',
            stagger: {
              grid: [7, 7],
              from: 'top',
              amount: state.turbo ? 0.08 : 0.2
            }
          }
        );
      }

      document.getElementById('activeMultCount').textContent = String(activeMultCells);
      document.getElementById('maxGridMultBadge').textContent = maxMult + 'x';
    }

    const particles = [];
    const floatingTexts = [];
    const shockwaves = [];
    const laserBeams = [];
    let fxAnimId = null;

    function spawnClusterLaserBeams(clusters) {
      const canvas = document.getElementById('fxCanvas');
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width;
      canvas.height = rect.height;
      const cellW = canvas.width / 7;
      const cellH = canvas.height / 7;

      clusters.forEach(w => {
        const pts = w.positions;
        for (let i = 0; i < pts.length; i++) {
          for (let j = i + 1; j < pts.length; j++) {
            const [r1, c1] = pts[i];
            const [r2, c2] = pts[j];
            if (Math.abs(r1 - r2) + Math.abs(c1 - c2) === 1) {
              laserBeams.push({
                x1: (c1 + 0.5) * cellW,
                y1: (r1 + 0.5) * cellH,
                x2: (c2 + 0.5) * cellW,
                y2: (r2 + 0.5) * cellH,
                alpha: 1.0
              });
            }
          }
        }
      });
      if (!fxAnimId) animateParticles();
    }

    function spawnParticles(gridCoords, color, isBomba = false, winText = '') {
      const canvas = document.getElementById('fxCanvas');
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width;
      canvas.height = rect.height;

      const cellW = canvas.width / 7;
      const cellH = canvas.height / 7;

      let sumX = 0;
      let sumY = 0;

      gridCoords.forEach(([r, c]) => {
        const cx = (c + 0.5) * cellW;
        const cy = (r + 0.5) * cellH;
        sumX += cx;
        sumY += cy;
        const count = isBomba ? 22 : 9;
        for (let i = 0; i < count; i++) {
          const angle = Math.random() * Math.PI * 2;
          const speed = (isBomba ? 4.2 : 2.3) + Math.random() * 4.8;
          particles.push({
            x: cx,
            y: cy,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed - 1.5,
            radius: (isBomba ? 4.5 : 2.8) + Math.random() * 3,
            color: isBomba && i % 2 === 0 ? '#fde047' : color,
            alpha: 1.0
          });
        }
      });

      if (gridCoords.length > 0) {
        const centerX = sumX / gridCoords.length;
        const centerY = sumY / gridCoords.length;
        if (winText) {
          floatingTexts.push({
            x: centerX,
            y: centerY,
            text: winText,
            alpha: 1.0,
            vy: -1.7
          });
        }
        if (isBomba) {
          shockwaves.push({
            x: centerX,
            y: centerY,
            radius: 10,
            maxRadius: canvas.width * 0.52,
            alpha: 1.0
          });
        }
      }

      if (!fxAnimId) {
        animateParticles();
      }
    }

    function animateParticles() {
      const canvas = document.getElementById('fxCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      for (let i = laserBeams.length - 1; i >= 0; i--) {
        const lb = laserBeams[i];
        lb.alpha -= 0.05;
        if (lb.alpha <= 0) {
          laserBeams.splice(i, 1);
          continue;
        }
        ctx.save();
        ctx.globalAlpha = Math.max(0, lb.alpha);
        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = 7;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(lb.x1, lb.y1);
        ctx.lineTo(lb.x2, lb.y2);
        ctx.stroke();

        ctx.strokeStyle = '#fef08a';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.moveTo(lb.x1, lb.y1);
        ctx.lineTo(lb.x2, lb.y2);
        ctx.stroke();
        ctx.restore();
      }

      for (let i = shockwaves.length - 1; i >= 0; i--) {
        const sw = shockwaves[i];
        sw.radius += 7.8;
        sw.alpha -= 0.045;
        if (sw.alpha <= 0 || sw.radius >= sw.maxRadius) {
          shockwaves.splice(i, 1);
          continue;
        }
        ctx.save();
        ctx.globalAlpha = Math.max(0, sw.alpha);
        ctx.strokeStyle = '#fde047';
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.arc(sw.x, sw.y, sw.radius, 0, Math.PI * 2);
        ctx.stroke();
        ctx.restore();
      }

      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.16;
        p.alpha -= 0.03;
        if (p.alpha <= 0) {
          particles.splice(i, 1);
          continue;
        }
        ctx.save();
        ctx.globalAlpha = Math.max(0, p.alpha);
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      for (let i = floatingTexts.length - 1; i >= 0; i--) {
        const ft = floatingTexts[i];
        ft.y += ft.vy;
        ft.alpha -= 0.024;
        if (ft.alpha <= 0) {
          floatingTexts.splice(i, 1);
          continue;
        }
        ctx.save();
        ctx.globalAlpha = Math.max(0, ft.alpha);
        ctx.font = "900 23px 'Lilita One', sans-serif";
        ctx.textAlign = 'center';
        ctx.strokeStyle = '#082f49';
        ctx.lineWidth = 5;
        ctx.strokeText(ft.text, ft.x, ft.y);
        ctx.fillStyle = '#fde047';
        ctx.fillText(ft.text, ft.x, ft.y);
        ctx.restore();
      }

      if (particles.length > 0 || floatingTexts.length > 0 || shockwaves.length > 0 || laserBeams.length > 0) {
        fxAnimId = requestAnimationFrame(animateParticles);
      } else {
        fxAnimId = null;
      }
    }

    function triggerBoardShake() {
      const frame = document.getElementById('boardFrameContainer');
      if (!frame) return;
      frame.classList.remove('shake-active');
      void frame.offsetWidth;
      frame.classList.add('shake-active');
    }

    function sleep(ms) {
      const factor = state.turbo ? 0.42 : 1.0;
      return new Promise(resolve => setTimeout(resolve, Math.max(40, ms * factor)));
    }

    // =========================================================================
    // 7. ROUND EXECUTION & CASCADE SEQUENCER
    // =========================================================================
    async function executeSpin(overrideMode = null) {
      if (state.isSpinning) return;
      hideSymbolTooltip();
      dismissBigWinOverlay();

      const modeToPlay = overrideMode || state.activeMode;
      const modeObj = GAME_MODES[modeToPlay] || GAME_MODES.base;
      const baseBet = BET_LEVELS[state.betIndex];
      const roundCost = state.inFreeSpins ? 0 : +(baseBet * modeObj.costMultiplier).toFixed(2);

      if (state.balance < roundCost) {
        showToast('Insufficient balance! Demo balance topped up to $1,000.00.');
        state.balance = 1000.00;
        updateHud();
        return;
      }

      state.isSpinning = true;
      state.sessionSpins += 1;
      state.balance = +(state.balance - roundCost).toFixed(2);
      state.displayedWin = 0;
      if (state.inFreeSpins) {
        state.freeSpinsRemaining = Math.max(0, state.freeSpinsRemaining - 1);
      }
      document.getElementById('hudWinValue').textContent = formatCurrency(0);
      document.getElementById('tumbleStepBadge').textContent = 'Tumble #0';
      document.getElementById('tumbleFeedContainer').innerHTML = '';
      updateComboMeterUI(0);

      const spinSvg = document.getElementById('spinArrowsSvg');
      if (spinSvg) spinSvg.classList.add('spin-icon-active');
      const kokoImg = document.getElementById('kokoAvatarImg');
      if (kokoImg) kokoImg.classList.add('koko-mascot-watching');

      updateHud();
      playParrotSound('chirp');

      const playRes = await rgsRequest('/wallet/play', {
        sessionID: RGS_CONFIG.sessionID,
        amount: Math.round(baseBet * 1000000),
        mode: modeToPlay
      });

      const book = playRes.book;
      state.lastBook = book;
      updateRgsInspectorModal();

      if (overrideMode) {
        state.activeMode = 'base';
      }

      if (state.forcedOutcome !== 'random') {
        state.forcedOutcome = 'random';
        const sel = document.getElementById('forceOutcomeSelect');
        if (sel) sel.value = 'random';
      }

      const revealEv = book.events.find(e => e.type === 'reveal');
      if (revealEv) {
        state.grid = revealEv.board.map(r => [...r]);
        state.cellHits = revealEv.gridHits.map(r => [...r]);
        renderGrid(state.grid, state.cellHits, new Set(), new Set(), true);
        for (let c = 0; c < 7; c++) playReelDropThud(c);
      }

      await sleep(340);
      if (kokoImg) kokoImg.classList.remove('koko-mascot-watching');

      const tumbleEvents = book.events.filter(e => e.type === 'tumbleStep');
      if (tumbleEvents.length === 0) {
        setKokoSpeech('No 5+ cluster this drop — spin again or click MODES for Loco Boost!');
      }

      for (const step of tumbleEvents) {
        document.getElementById('tumbleStepBadge').textContent = 'Tumble #' + step.tumbleNumber;
        updateComboMeterUI(step.tumbleNumber);

        const winSet = new Set(step.explodingPositions.map(([r, c]) => `${r},${c}`));
        renderGrid(state.grid, state.cellHits, winSet, new Set(), false);
        spawnClusterLaserBeams(step.wins);

        const stepWinCash = +(step.stepWinMultiplier * baseBet).toFixed(2);
        const cumWinCash = +(step.cumulativeMultiplier * baseBet).toFixed(2);
        animateWinReadout(cumWinCash);

        playParrotSound(step.bombaTriggered ? 'squawk' : 'koko_whistle', step.tumbleNumber);
        animateKokoMascot();
        if (step.bombaTriggered || step.stepWinMultiplier >= 5) {
          triggerBoardShake();
        }
        spawnParticles(step.explodingPositions, '#38bdf8', step.bombaTriggered, '+' + formatCurrency(stepWinCash));
        appendTumbleLogEntry(step, baseBet);

        setKokoSpeech(step.bombaTriggered
          ? 'SQUAWK! Bomba Wild exploded and upgraded surrounding 3x3 multipliers!'
          : `KO-KO! Tumble #${step.tumbleNumber} hit! Round Win: ${formatCurrency(cumWinCash)}`);

        await sleep(480);

        // Priority 7: Exit-faster-than-enter cluster implosion (220ms)
        renderGrid(state.grid, state.cellHits, new Set(), winSet, false);
        await sleep(220);

        state.grid = step.boardAfter.map(r => [...r]);
        state.cellHits = step.gridHitsAfter.map(r => [...r]);
        renderGrid(state.grid, state.cellHits, new Set(), new Set(), true);
        playReelDropThud(2);
        await sleep(320);
      }

      const fsEv = book.events.find(e => e.type === 'freeSpinTrigger');
      if (fsEv) {
        playParrotSound('squawk');
        animateKokoMascot();
        triggerBoardShake();
        triggerCoinFountainShow();
        state.inFreeSpins = true;
        state.freeSpinsRemaining += fsEv.awardedFreeSpins;
        state.freeSpinsTotal += fsEv.awardedFreeSpins;
        setKokoSpeech(`ARRIBA! ${fsEv.scatterCount} FS Crystals! +${fsEv.awardedFreeSpins} Cartel Free Spins with locked multipliers!`);
        showToast(`BONUS TRIGGERED! +${fsEv.awardedFreeSpins} Cartel Free Spins!`);
      }

      const totalWinCash = +(book.payoutMultiplier * baseBet).toFixed(2);
      if (totalWinCash > 0) {
        state.balance = +(state.balance + totalWinCash).toFixed(2);
      }
      if (book.payoutMultiplier > state.bestHitMult) {
        state.bestHitMult = book.payoutMultiplier;
      }
      await rgsRequest('/wallet/end-round', { sessionID: RGS_CONFIG.sessionID });

      if (book.payoutMultiplier >= 15) {
        playParrotSound('squawk');
        triggerBoardShake();
        triggerCoinFountainShow();
        showBigWinOverlay(totalWinCash, book.payoutMultiplier);
      }

      if (state.inFreeSpins && state.freeSpinsRemaining <= 0) {
        state.inFreeSpins = false;
        state.freeSpinsTotal = 0;
        showToast('Cartel Free Spins completed! Grid multipliers reset.');
      }

      if (spinSvg) spinSvg.classList.remove('spin-icon-active');
      state.isSpinning = false;
      updateHud();

      if (state.autoSpin || (state.inFreeSpins && state.freeSpinsRemaining > 0)) {
        setTimeout(() => {
          if (state.autoSpin || (state.inFreeSpins && state.freeSpinsRemaining > 0)) {
            executeSpin();
          }
        }, state.turbo ? 350 : 750);
      }
    }

    function appendTumbleLogEntry(step, baseBet) {
      const container = document.getElementById('tumbleFeedContainer');
      if (!container) return;
      const emptyEl = document.getElementById('emptyTumbleText');
      if (emptyEl) emptyEl.remove();

      step.wins.forEach(w => {
        const sym = SYMBOL_MAP[w.symbol] || SYMBOLS[0];
        const cash = (w.winMultiplier * baseBet).toFixed(2);
        const row = document.createElement('div');
        row.className = 'flex items-center justify-between bg-slate-900/90 border border-slate-700 rounded-lg px-2 py-1';
        row.innerHTML = `
          <div class="flex items-center gap-1.5 truncate">
            <span class="tabular-nums text-[10px] text-amber-400">#${step.tumbleNumber}</span>
            <span class="font-bold text-slate-100 truncate">${w.size}x ${sym.nameEn}</span>
            ${w.locoGridMultiplier > 1 ? `<span class="px-1 py-0.2 rounded bg-cyan-600 text-white font-black text-[9px] tabular-nums">${w.locoGridMultiplier}x</span>` : ''}
          </div>
          <span class="tabular-nums font-bold text-emerald-400 ml-1">+${formatCurrency(cash)}</span>
        `;
        container.prepend(row);
      });
    }

    // =========================================================================
    // 8. INTERACTIVE CONTROLS, MODALS & SOCIAL MODE COMPLIANCE
    // =========================================================================
