    // =========================================================================
    // 5. STAKE ENGINE RGS CLIENT & STATELESS MATH BOOK GENERATOR
    // =========================================================================
    function getCellMultiplier(hits) {
      if (hits <= 0) return 1;
      const multTable = [1, 2, 3, 5, 10, 25, 50, 100, 128];
      return multTable[Math.min(multTable.length - 1, hits)];
    }

    function pickWeightedSymbol(mode, allowSpecial = true) {
      const boost = (mode === 'loco_boost' || mode === 'bonus_buy' || mode === 'super_loco_buy');
      const pool = [];
      SYMBOLS.forEach(sym => {
        if (!allowSpecial && (sym.id === 'WILD_BOMBA' || sym.id === 'SCAT_SKULL')) return;
        let w = sym.weight;
        if (boost && (sym.id === 'WILD_BOMBA' || sym.id === 'SCAT_SKULL' || sym.id === 'S1_KOKO')) {
          w *= 2.4;
        }
        pool.push({ id: sym.id, weight: w });
      });
      const total = pool.reduce((acc, item) => acc + item.weight, 0);
      let r = Math.random() * total;
      for (const item of pool) {
        if (r < item.weight) return item.id;
        r -= item.weight;
      }
      return 'S9_TEN';
    }

    function createInitialBoard(mode, forcedType, hitsGrid) {
      const board = Array.from({ length: 7 }, () => Array(7).fill('S9_TEN'));
      for (let r = 0; r < 7; r++) {
        for (let c = 0; c < 7; c++) {
          board[r][c] = pickWeightedSymbol(mode, true);
          if (board[r][c] === 'S1_KOKO' && hitsGrid[r][c] === 0) {
            const seedHits = [1, 1, 2, 3, 4][Math.floor(Math.random() * 5)];
            hitsGrid[r][c] = seedHits;
          }
        }
      }

      if (forcedType === 'cascade_bomba') {
        const coords = [[2,2],[2,3],[2,4],[3,2],[3,4],[4,3]];
        coords.forEach(([r, c]) => { board[r][c] = 'S2_GOLD'; });
        board[3][3] = 'WILD_BOMBA';
        [[1,2],[1,3],[1,4],[0,2],[0,3]].forEach(([r, c], idx) => {
          board[r][c] = 'S1_KOKO';
          hitsGrid[r][c] = (idx % 4) + 1;
        });
      } else if (forcedType === 'free_spins' || mode === 'bonus_buy' || mode === 'super_loco_buy') {
        const scatCoords = [[1,1], [3,5], [5,2]];
        if (mode === 'super_loco_buy') scatCoords.push([2,4]);
        scatCoords.forEach(([r, c]) => { board[r][c] = 'SCAT_SKULL'; });
        [[4,1],[4,2],[4,3],[5,1],[5,3]].forEach(([r, c]) => { board[r][c] = 'S3_TEQUILA'; });
      } else if (forcedType === 'mega_win') {
        const kokoCluster = [
          [1,1],[1,2],[1,3],[1,4],[1,5],
          [2,1],[2,2],[2,4],[2,5],
          [3,1],[3,2],[3,3],[3,4],[3,5],
          [4,2],[4,3],[4,4]
        ];
        kokoCluster.forEach(([r, c], i) => {
          board[r][c] = 'S1_KOKO';
          hitsGrid[r][c] = (i % 4) + 2;
        });
        board[2][3] = 'WILD_BOMBA';
        board[3][3] = 'WILD_BOMBA';
      }
      return board;
    }

    function findWinningClusters(board) {
      const paySymIds = SYMBOLS.filter(s => s.tier !== 'special' && s.tier !== 'scatter').map(s => s.id);
      const clusters = [];
      const claimedCells = new Set();

      for (const targetSym of paySymIds) {
        const visited = Array.from({ length: 7 }, () => Array(7).fill(false));
        for (let r = 0; r < 7; r++) {
          for (let c = 0; c < 7; c++) {
            if (visited[r][c] || board[r][c] !== targetSym) continue;
            const queue = [[r, c]];
            const component = [];
            visited[r][c] = true;

            while (queue.length > 0) {
              const [cr, cc] = queue.shift();
              component.push([cr, cc]);
              const dirs = [[-1,0],[1,0],[0,-1],[0,1]];
              for (const [dr, dc] of dirs) {
                const nr = cr + dr;
                const nc = cc + dc;
                if (nr >= 0 && nr < 7 && nc >= 0 && nc < 7 && !visited[nr][nc]) {
                  const cellSym = board[nr][nc];
                  if (cellSym === targetSym || cellSym === 'WILD_BOMBA') {
                    visited[nr][nc] = true;
                    queue.push([nr, nc]);
                  }
                }
              }
            }

            if (component.length >= 5) {
              const key = component.map(([rr, cc]) => `${rr},${cc}`).sort().join('|');
              if (!claimedCells.has(key)) {
                claimedCells.add(key);
                const hasBomba = component.some(([rr, cc]) => board[rr][cc] === 'WILD_BOMBA');
                clusters.push({
                  symbol: targetSym,
                  positions: component,
                  size: component.length,
                  hasBomba
                });
              }
            }
          }
        }
      }
      return clusters;
    }

    function getSymbolBasePayout(symId, clusterSize) {
      const sym = SYMBOL_MAP[symId];
      if (!sym || !sym.pays) return 0;
      if (clusterSize >= 15) return sym.pays[4];
      if (clusterSize >= 12) return sym.pays[3];
      if (clusterSize >= 9) return sym.pays[2];
      if (clusterSize >= 7) return sym.pays[1];
      return sym.pays[0];
    }

    function simulateStatelessRoundBook(betAmount, mode, forcedOutcome) {
      state.simCounter += 1;
      const bookId = state.simCounter;
      const events = [];
      let totalMultiplier = 0;

      const hitsGrid = state.inFreeSpins
        ? state.cellHits.map(row => [...row])
        : Array.from({ length: 7 }, () => Array(7).fill(0));

      if (mode === 'super_loco_buy' && !state.inFreeSpins) {
        for (let r = 2; r <= 4; r++) {
          for (let c = 2; c <= 4; c++) {
            hitsGrid[r][c] = 3;
          }
        }
      }

      const currentBoard = createInitialBoard(mode, forcedOutcome, hitsGrid);

      events.push({
        index: events.length,
        type: 'reveal',
        board: currentBoard.map(row => [...row]),
        gridHits: hitsGrid.map(row => [...row]),
        gameType: state.inFreeSpins ? 'freegame' : 'basegame'
      });

      let tumbleIndex = 0;
      while (tumbleIndex < 8) {
        const clusters = findWinningClusters(currentBoard);
        if (clusters.length === 0) break;
        tumbleIndex += 1;

        const explodingSet = new Set();
        const bombaPositions = [];
        const winDetails = [];
        let stepWinMult = 0;

        for (const cl of clusters) {
          const basePay = getSymbolBasePayout(cl.symbol, cl.size);
          let clusterMultSum = 0;
          for (const [r, c] of cl.positions) {
            const m = getCellMultiplier(hitsGrid[r][c]);
            if (m > 1) clusterMultSum += m;
            explodingSet.add(`${r},${c}`);
            if (currentBoard[r][c] === 'WILD_BOMBA') {
              bombaPositions.push([r, c]);
            }
          }
          const appliedMult = clusterMultSum > 0 ? clusterMultSum : 1;
          const finalClusterMult = +(basePay * appliedMult).toFixed(2);
          stepWinMult = +(stepWinMult + finalClusterMult).toFixed(2);

          winDetails.push({
            symbol: cl.symbol,
            size: cl.size,
            baseMultiplier: basePay,
            locoGridMultiplier: appliedMult,
            winMultiplier: finalClusterMult,
            positions: cl.positions
          });
        }

        totalMultiplier = +(totalMultiplier + stepWinMult).toFixed(2);

        for (const posStr of explodingSet) {
          const [r, c] = posStr.split(',').map(Number);
          hitsGrid[r][c] = Math.min(8, hitsGrid[r][c] + 1);
        }
        for (const [br, bc] of bombaPositions) {
          for (let dr = -1; dr <= 1; dr++) {
            for (let dc = -1; dc <= 1; dc++) {
              const nr = br + dr;
              const nc = bc + dc;
              if (nr >= 0 && nr < 7 && nc >= 0 && nc < 7) {
                hitsGrid[nr][nc] = Math.max(2, Math.min(8, hitsGrid[nr][nc] + 1));
              }
            }
          }
        }

        const nextBoard = currentBoard.map(row => [...row]);
        for (const posStr of explodingSet) {
          const [r, c] = posStr.split(',').map(Number);
          nextBoard[r][c] = null;
        }

        for (let c = 0; c < 7; c++) {
          const remaining = [];
          for (let r = 6; r >= 0; r--) {
            if (nextBoard[r][c] !== null) remaining.push(nextBoard[r][c]);
          }
          for (let r = 6; r >= 0; r--) {
            const idx = 6 - r;
            if (idx < remaining.length) {
              nextBoard[r][c] = remaining[idx];
            } else {
              nextBoard[r][c] = pickWeightedSymbol(mode, tumbleIndex < 2);
              if (nextBoard[r][c] === 'S1_KOKO' && hitsGrid[r][c] === 0) {
                hitsGrid[r][c] = [1, 2, 3][Math.floor(Math.random() * 3)];
              }
            }
          }
        }

        events.push({
          index: events.length,
          type: 'tumbleStep',
          tumbleNumber: tumbleIndex,
          wins: winDetails,
          stepWinMultiplier: stepWinMult,
          cumulativeMultiplier: totalMultiplier,
          explodingPositions: Array.from(explodingSet).map(s => s.split(',').map(Number)),
          bombaTriggered: bombaPositions.length > 0,
          gridHitsAfter: hitsGrid.map(row => [...row]),
          boardAfter: nextBoard.map(row => [...row])
        });

        for (let r = 0; r < 7; r++) {
          for (let c = 0; c < 7; c++) {
            currentBoard[r][c] = nextBoard[r][c];
          }
        }
      }

      let scatterCount = 0;
      const scatterPositions = [];
      for (let r = 0; r < 7; r++) {
        for (let c = 0; c < 7; c++) {
          if (currentBoard[r][c] === 'SCAT_SKULL') {
            scatterCount += 1;
            scatterPositions.push([r, c]);
          }
        }
      }

      let awardedFreeSpins = 0;
      if (scatterCount >= 3) {
        const fsTable = { 3: 10, 4: 12, 5: 15, 6: 20, 7: 25 };
        awardedFreeSpins = fsTable[Math.min(7, scatterCount)] || 10;
        events.push({
          index: events.length,
          type: 'freeSpinTrigger',
          scatterCount,
          awardedFreeSpins,
          scatterPositions
        });
      }

      events.push({
        index: events.length,
        type: 'finalWin',
        payoutMultiplier: totalMultiplier,
        amountMicro: Math.round(totalMultiplier * betAmount * 1000000)
      });

      return {
        id: bookId,
        mode,
        payoutMultiplier: totalMultiplier,
        events,
        finalGridHits: hitsGrid
      };
    }

    async function rgsRequest(endpoint, payload) {
      if (RGS_CONFIG.rgsUrl && RGS_CONFIG.rgsUrl.startsWith('http')) {
        try {
          const targetUrl = RGS_CONFIG.rgsUrl.replace(/\/$/, '') + endpoint;
          const res = await window.fetch(targetUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if (res.ok) return await res.json();
        } catch (err) {}
      }

      if (endpoint === '/wallet/authenticate') {
        return {
          status: 'OK',
          sessionID: RGS_CONFIG.sessionID,
          balance: { amount: Math.round(state.balance * 1000000), currency: state.socialMode ? 'SC' : RGS_CONFIG.currency },
          config: {
            gameId: 'koko-loco-7x7',
            jurisdiction: { socialCasino: state.socialMode },
            modes: Object.keys(GAME_MODES)
          }
        };
      }
      if (endpoint === '/wallet/play') {
        const baseBet = BET_LEVELS[state.betIndex];
        const book = simulateStatelessRoundBook(baseBet, payload.mode, state.forcedOutcome);
        return {
          status: 'OK',
          roundId: 'rnd_' + book.id,
          balance: { amount: Math.round(state.balance * 1000000), currency: state.socialMode ? 'SC' : RGS_CONFIG.currency },
          book
        };
      }
      if (endpoint === '/wallet/end-round') {
        return {
          status: 'SETTLED',
          balance: { amount: Math.round(state.balance * 1000000), currency: state.socialMode ? 'SC' : RGS_CONFIG.currency }
        };
      }
      return { status: 'OK' };
    }

