      document.getElementById('sessionSpinsBadge').textContent = String(state.sessionSpins);
      document.getElementById('bestHitMultBadge').textContent = state.bestHitMult.toFixed(2) + 'x';

      [0, 2, 4, 6].forEach(idx => {
        const pBtn = document.getElementById('btnPresetBet' + idx);
        if (!pBtn) return;
        if (state.betIndex === idx) {
          pBtn.className = 'px-2 py-1 rounded-lg text-[10px] tabular-nums font-bold bg-amber-500/25 text-amber-300 border border-amber-400/60 transition';
        } else {
          pBtn.className = 'px-2 py-1 rounded-lg text-[10px] tabular-nums font-bold text-slate-300 hover:bg-slate-800 transition';
        }
      });

      document.getElementById('costBadge_bonus_buy').textContent = formatCurrency(baseBet * 100);
      document.getElementById('costBadge_super_loco_buy').textContent = formatCurrency(baseBet * 250);

      ['base', 'loco_boost'].forEach(m => {
        const btn = document.getElementById('modeBtn_' + m);
        if (!btn) return;
        if (state.activeMode === m) {
          btn.className = 'mode-card text-left p-3.5 rounded-xl border-2 transition-all bg-slate-800/95 border-amber-400 shadow-[0_0_15px_rgba(245,158,11,0.3)]';
        } else {
          btn.className = 'mode-card text-left p-3.5 rounded-xl border-2 transition-all bg-slate-800/60 border-slate-600 hover:border-amber-400';
        }
      });

      const fsBanner = document.getElementById('freeSpinsBanner');
      const fsBadge = document.getElementById('freeSpinsCounterBadge');
      const stageWrap = document.getElementById('stageWrapper');
      const boardFrame = document.getElementById('boardFrameContainer');

      if (state.inFreeSpins) {
        fsBanner.classList.remove('hidden');
        document.getElementById('fsRemainingCount').textContent = `${state.freeSpinsRemaining} / ${state.freeSpinsTotal}`;
        fsBadge.textContent = `FREE SPINS: ${state.freeSpinsRemaining}`;
        fsBadge.className = 'mt-1 inline-block px-2 py-0.5 rounded-full bg-red-600 text-white text-[9px] font-black tracking-wider animate-pulse';
        if (stageWrap) stageWrap.classList.add('free-spins-mode');
        if (boardFrame) boardFrame.classList.add('frame-free-spins');
      } else {
        fsBanner.classList.add('hidden');
        fsBadge.textContent = modeObj.labelEn.toUpperCase();
        fsBadge.className = 'mt-1 inline-block px-2 py-0.5 rounded-full bg-slate-900 text-amber-300 text-[9px] font-black tracking-wider';
        if (stageWrap) stageWrap.classList.remove('free-spins-mode');
        if (boardFrame) boardFrame.classList.remove('frame-free-spins');
      }

      document.getElementById('rtpHeaderBadge').textContent = `RTP ${modeObj.rtp.toFixed(2)}% • 7x7 CLUSTER`;
      document.getElementById('btnSpin').disabled = state.isSpinning;

      applySocialModeTerminology();
    }

    function applySocialModeTerminology() {
      const isSoc = state.socialMode;
      document.getElementById('lblHudBalance').textContent = isSoc ? 'COINS BALANCE' : 'BALANCE';
      document.getElementById('lblHudBet').textContent = isSoc ? 'PLAY' : 'BET';
      document.getElementById('lblHudWin').textContent = 'WIN';
      document.getElementById('lblModesHeader').textContent = isSoc
        ? 'GAME MODES & PLAY FEATURES (SOCIAL)'
        : 'GAME MODES & BONUS FEATURES';

      const socDot = document.getElementById('socialIndicator');
      const socTxt = document.getElementById('txtSocialBtn');
      if (isSoc) {
        socDot.className = 'w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_6px_#34d399]';
        socTxt.textContent = 'Social Mode: ON (Stake.us)';
      } else {
        socDot.className = 'w-2 h-2 rounded-full bg-slate-400';
        socTxt.textContent = 'Social Mode: OFF';
      }
    }

    function adjustBet(delta) {
      if (state.isSpinning || state.inFreeSpins) return;
      state.betIndex = Math.max(0, Math.min(BET_LEVELS.length - 1, state.betIndex + delta));
      playParrotSound('chirp');
      updateHud();
    }

    function setBetIndexDirect(idx) {
      if (state.isSpinning || state.inFreeSpins) return;
      state.betIndex = Math.max(0, Math.min(BET_LEVELS.length - 1, idx));
      playParrotSound('chirp');
      updateHud();
    }

    function selectGameMode(modeId) {
      if (state.isSpinning || state.inFreeSpins) return;
      state.activeMode = modeId;
      playParrotSound('chirp');
      updateHud();
      showToast(`Mode Selected: ${GAME_MODES[modeId].labelEn} (RTP ${GAME_MODES[modeId].rtp}%)`);
    }

    function triggerFeatureBuy(modeId) {
      if (state.isSpinning || state.inFreeSpins) return;
      executeSpin(modeId);
    }

    function handleOutcomePresetChange(val) {
      state.forcedOutcome = val;
      showToast('Next spin will demonstrate the selected RGS outcome!');
    }

    function toggleSocialMode() {
      state.socialMode = !state.socialMode;
      RGS_CONFIG.social = state.socialMode;
      updateHud();
      updateRgsInspectorModal();
      showToast(state.socialMode
        ? 'Stake.us Social Mode enabled — gambling terms switched to Social Casino terms.'
        : 'Standard Mode (Stake.com) enabled.');
    }

    function toggleTurbo() {
      state.turbo = !state.turbo;
      const btn = document.getElementById('btnTurbo');
      btn.className = state.turbo
        ? 'w-9 h-9 rounded-full bg-amber-400 text-slate-950 border-2 border-white font-black text-xs flex items-center justify-center shadow transition'
        : 'w-9 h-9 rounded-full bg-slate-100 hover:bg-white text-slate-950 border-2 border-slate-900 font-black text-xs flex items-center justify-center shadow transition';
    }

    function toggleAutoSpin() {
      state.autoSpin = !state.autoSpin;
      const btn = document.getElementById('btnAutoSpin');
      const txt = document.getElementById('txtAutoBtn');
      if (state.autoSpin) {
        btn.className = 'w-9 h-9 rounded-full bg-emerald-400 text-slate-950 border-2 border-white font-black text-xs flex items-center justify-center shadow transition';
        txt.textContent = '■';
        if (!state.isSpinning) executeSpin();
      } else {
        btn.className = 'w-9 h-9 rounded-full bg-slate-100 hover:bg-white text-slate-950 border-2 border-slate-900 font-black text-xs flex items-center justify-center shadow transition';
        txt.textContent = '↻';
      }
    }

    function toggleAudio() {
      state.audioEnabled = !state.audioEnabled;
      document.getElementById('iconAudio').textContent = state.audioEnabled ? '🔊' : '🔇';
      const svgOn = document.getElementById('svgAudioOn');
      const svgOff = document.getElementById('svgAudioOff');
      if (svgOn && svgOff) {
        svgOn.classList.toggle('hidden', !state.audioEnabled);
        svgOff.classList.toggle('hidden', state.audioEnabled);
      }
      if (state.audioEnabled) playParrotSound('chirp');
    }

    function setKokoSpeech(text) {
      const el = document.getElementById('kokoSpeechBubble');
      if (el) el.textContent = `"${text}"`;
    }

    function showBigWinOverlay(amount, mult) {
      const overlay = document.getElementById('bigWinOverlay');
      if (!overlay) return;
      let tier = 'BIG LOCO WIN!';
      if (mult >= 100) tier = 'EL JEFE CARTEL MEGA WIN!';
      else if (mult >= 40) tier = 'SUPER LOCO WIN!';
      document.getElementById('bigWinTierLabel').textContent = tier;
      document.getElementById('bigWinAmountDisplay').textContent = formatCurrency(amount);
      document.getElementById('bigWinMultDisplay').textContent = mult.toFixed(2) + 'x';
      overlay.classList.remove('hidden');
      const inner = document.getElementById('bigWinCardInner');
      if (inner && window.gsap) {
        window.gsap.fromTo(inner,
          { scale: 0.72, opacity: 0 },
          { scale: 1, opacity: 1, duration: 0.34, ease: 'back.out(1.8)' }
        );
      }
    }

    function dismissBigWinOverlay() {
      const overlay = document.getElementById('bigWinOverlay');
      if (overlay) overlay.classList.add('hidden');
    }

    function showSymbolTooltip(symId) {
      const sym = SYMBOL_MAP[symId];
      const tooltip = document.getElementById('symbolTooltip');
      if (!sym || !tooltip) return;

      document.getElementById('tooltipSymName').textContent = sym.nameEn;
      const body = document.getElementById('tooltipSymBody');
      if (sym.id === 'WILD_BOMBA') {
        body.innerHTML = `<p>Substitutes for all regular symbols and upgrades 3x3 surrounding cell multipliers when it explodes!</p>`;
      } else if (sym.id === 'SCAT_SKULL') {
        body.innerHTML = `<p>3, 4, 5, 6, or 7 FS Scatters award 10, 12, 15, 20, or 25 Cartel Free Spins with persistent multipliers!</p>`;
      } else {
        const baseBet = BET_LEVELS[state.betIndex];
        const brackets = ['5–6', '7–8', '9–11', '12–14', '15+'];
        body.innerHTML = brackets.map((b, i) => `
          <div class="flex justify-between">
            <span>Cluster ${b}:</span>
            <span class="tabular-nums font-bold text-cyan-300">${sym.pays[i]}x (${formatCurrency(sym.pays[i] * baseBet)})</span>
          </div>
        `).join('');
      }

      tooltip.style.top = '14px';
      tooltip.style.left = '14px';
      tooltip.classList.remove('hidden');
      if (window.gsap) {
        window.gsap.fromTo(tooltip, { scale: 0.9, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.2, ease: 'back.out(1.7)' });
      }
    }

    function hideSymbolTooltip() {
      const tooltip = document.getElementById('symbolTooltip');
      if (tooltip) tooltip.classList.add('hidden');
    }

    function toggleModal(modalId, show) {
      const el = document.getElementById(modalId);
      if (!el) return;
      if (show) {
        if (modalId === 'rgsModal') updateRgsInspectorModal();
        if (modalId === 'rulesModal') populatePaytableModal();
        el.classList.remove('hidden');
        const card = document.getElementById(modalId + 'Card');
        if (card && window.gsap) {
          window.gsap.fromTo(card,
            { scale: 0.9, y: 18, opacity: 0 },
            { scale: 1, y: 0, opacity: 1, duration: 0.26, ease: 'back.out(1.6)' }
          );
        }
      } else {
        el.classList.add('hidden');
      }
    }

    function populatePaytableModal() {
      const grid = document.getElementById('paytableModalGrid');
      if (!grid) return;
      grid.innerHTML = '';
      SYMBOLS.forEach(sym => {
        const card = document.createElement('div');
        card.className = 'flex items-center gap-3 bg-slate-950 border border-slate-800 rounded-xl p-2.5';
        let details = '';
        if (sym.id === 'WILD_BOMBA') {
          details = `<div class="text-xs text-slate-300">Substitutes all regular symbols + boosts 3x3 grid multipliers</div>`;
        } else if (sym.id === 'SCAT_SKULL') {
          details = `<div class="text-xs text-slate-300">3+ FS Scatters trigger 10–25 Cartel Free Spins</div>`;
        } else {
          details = `<div class="text-[11px] tabular-nums text-cyan-300">5+: ${sym.pays[0]}x | 7+: ${sym.pays[1]}x | 9+: ${sym.pays[2]}x | 12+: ${sym.pays[3]}x | 15+: ${sym.pays[4]}x</div>`;
        }
        card.innerHTML = `
          <div class="w-12 h-12 shrink-0 flex items-center justify-center bg-slate-900 rounded-lg border border-slate-700">${sym.svg}</div>
          <div class="min-w-0 flex-1">
            <div class="font-bold text-amber-300 text-xs">${sym.nameEn}</div>
            ${details}
          </div>
        `;
        grid.appendChild(card);
      });
    }

    function getStakeEngineIndexManifest() {
      return {
        gameId: 'koko-loco',
        title: 'Koko Loco',
        version: '3.0.0-uiux-promax',
        stateless: true,
        grid: { rows: 7, cols: 7, mechanic: 'cluster_pays', minClusterSize: 5 },
        modes: [
          { name: 'base', cost: 1.0, rtp: 0.9635, events: 'books_base.jsonl.zst', weights: 'lookUpTable_base_0.csv' },
          { name: 'loco_boost', cost: 1.5, rtp: 0.9642, events: 'books_loco_boost.jsonl.zst', weights: 'lookUpTable_loco_boost_0.csv' },
          { name: 'bonus_buy', cost: 100.0, rtp: 0.9650, events: 'books_bonus_buy.jsonl.zst', weights: 'lookUpTable_bonus_buy_0.csv' },
          { name: 'super_loco_buy', cost: 250.0, rtp: 0.9658, events: 'books_super_loco_buy.jsonl.zst', weights: 'lookUpTable_super_loco_buy_0.csv' }
        ]
      };
    }

    function updateRgsInspectorModal() {
      const qDump = document.getElementById('rgsQueryDump');
      if (qDump) qDump.textContent = JSON.stringify(RGS_CONFIG, null, 2);
      const bDump = document.getElementById('rgsBookDump');
      if (bDump) {
        bDump.textContent = JSON.stringify(state.lastBook || { info: 'Click SPIN to generate a live RGS /wallet/play book payload' }, null, 2);
      }
      const iDump = document.getElementById('rgsIndexDump');
      if (iDump) iDump.textContent = JSON.stringify(getStakeEngineIndexManifest(), null, 2);
    }

    function copyRgsJson(kind) {
      const text = kind === 'index'
        ? JSON.stringify(getStakeEngineIndexManifest(), null, 2)
        : JSON.stringify(state.lastBook || {}, null, 2);
      const ta = document.createElement('textarea');
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      try {
        document.execCommand('copy');
        showToast('JSON copied to clipboard!');
      } catch (e) {}
      document.body.removeChild(ta);
    }

    let toastTimer = null;
    function showToast(msg) {
      const el = document.getElementById('toastBanner');
      if (!el) return;
      el.textContent = msg;
      el.classList.remove('hidden');
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        el.classList.add('hidden');
      }, 3200);
    }

    function updateClock() {
      const el = document.getElementById('liveClockText');
      if (!el) return;
      const now = new Date();
      const hh = String(now.getHours()).padStart(2, '0');
      const mm = String(now.getMinutes()).padStart(2, '0');
      el.textContent = `${hh}:${mm}`;
    }

    // =========================================================================
    // 9. INITIALIZATION & KEYBOARD ACCESSIBILITY ON WINDOW LOAD
    // =========================================================================
    window.addEventListener('keydown', (ev) => {
      if (ev.code === 'Escape') {
        toggleModal('modesModal', false);
        toggleModal('rgsModal', false);
        toggleModal('rulesModal', false);
        hideSymbolTooltip();
        dismissBigWinOverlay();
        return;
      }
      if (ev.code === 'Space' && !state.isSpinning) {
        const rgsOpen = !document.getElementById('rgsModal').classList.contains('hidden');
        const rulesOpen = !document.getElementById('rulesModal').classList.contains('hidden');
        const modesOpen = !document.getElementById('modesModal').classList.contains('hidden');
        if (!rgsOpen && !rulesOpen && !modesOpen) {
          ev.preventDefault();
          executeSpin();
        }
      }
    });

    window.onload = async () => {
      updateClock();
      setInterval(updateClock, 15000);
      startAmbientStageLoop();
      await rgsRequest('/wallet/authenticate', { sessionID: RGS_CONFIG.sessionID });
      state.cellHits = Array.from({ length: 7 }, () => Array(7).fill(0));
      state.grid = createInitialBoard('base', 'random', state.cellHits);
      renderGrid(state.grid, state.cellHits, new Set(), new Set(), true);
      populatePaytableModal();
      updateRgsInspectorModal();
      updateHud();
    };
  </script>
</body>
</html>