        if (tumbleStep >= 3) frame.classList.add('frame-combo-3');
        else if (tumbleStep === 2) frame.classList.add('frame-combo-2');
        else if (tumbleStep === 1) frame.classList.add('frame-combo-1');
      }
      if (statusEl) {
        if (tumbleStep === 0) statusEl.textContent = 'READY';
        else if (tumbleStep >= 3) statusEl.textContent = `LOCO OVERDRIVE #${tumbleStep}!`;
        else statusEl.textContent = `CHAIN #${tumbleStep}`;
