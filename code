<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Koko Loco — 7x7 Cluster Pays | Stake Engine Studio Pro Max</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Lilita+One&family=JetBrains+Mono:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --rx: 0deg;
      --ry: 0deg;
      --glow-color: rgba(56, 189, 248, 0.38);
      --bg-void: #040711;
      --surface-glass: rgba(11, 17, 32, 0.88);
      --surface-elevated: rgba(22, 32, 56, 0.94);
      --border-subtle: rgba(148, 163, 184, 0.24);
      --accent-cyan: #38bdf8;
      --accent-gold: #fbbf24;
      --accent-emerald: #10b981;
      --accent-crimson: #ef4444;
    }
    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
    }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      background-color: var(--bg-void);
      color: #f8fafc;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      overflow-x: hidden;
    }
    .tabular-nums {
      font-family: 'JetBrains Mono', monospace;
      font-variant-numeric: tabular-nums;
    }

    /* Priority 1 Accessibility: Clear Focus Rings */
    button:focus-visible,
    select:focus-visible {
      outline: 2.5px solid var(--accent-cyan) !important;
      outline-offset: 2px !important;
    }

    /* Full-Viewport Scenic Casino Stage with Dynamic Lighting */
    .stage-wrapper {
      position: relative;
      width: 100%;
      min-height: 100vh;
      background-image: url("data:image/jpeg;base64,");
      background-size: cover;
      background-position: center bottom;
      background-repeat: no-repeat;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
      transition: filter 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .stage-wrapper.free-spins-mode {
      filter: saturate(1.34) contrast(1.08);
    }
    .stage-vignette {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 50% 44%, rgba(8, 12, 26, 0.04) 0%, rgba(3, 6, 15, 0.68) 100%),
        linear-gradient(180deg, rgba(3, 6, 15, 0.6) 0%, transparent 16%, transparent 78%, rgba(3, 6, 15, 0.85) 100%);
      pointer-events: none;
      z-index: 1;
    }

    /* Ambient Pool & Lantern Shimmer Overlays */
    .pool-shimmer {
      position: absolute;
      left: 3%;
      bottom: 8%;
      width: 40%;
      height: 30%;
      background: radial-gradient(ellipse at center, rgba(34, 211, 238, 0.28) 0%, transparent 70%);
      filter: blur(24px);
      animation: poolGlow 3.8s ease-in-out infinite alternate;
      pointer-events: none;
      z-index: 2;
    }
    @keyframes poolGlow {
      0% { opacity: 0.45; transform: scale(0.95); }
      100% { opacity: 0.95; transform: scale(1.07); }
    }

    /* STRICT 3-COLUMN HORIZONTAL CASINO STAGE — PARROT ALWAYS ON RIGHT! */
    .casino-stage-grid {
      position: relative;
      z-index: 20;
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(120px, 225px) minmax(275px, 495px) minmax(130px, 245px);
      align-items: stretch;
      justify-content: center;
      gap: 0px;
      padding: 0 8px;
      perspective: 1200px;
    }
    @media (max-width: 640px) {
      .casino-stage-grid {
        grid-template-columns: minmax(86px, 118px) minmax(215px, 1fr) minmax(98px, 134px);
        padding: 0 3px;
      }
    }

    /* Pro Max Sculpted Classical Marble & Gold Architectural Frame */
    .architectural-frame {
      position: relative;
      padding: 20px 26px 22px 26px;
      border-radius: 20px;
      background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 22%, #cbd5e1 72%, #94a3b8 100%);
      box-shadow:
        0 28px 65px rgba(0, 0, 0, 0.95),
        0 0 48px var(--glow-color),
        inset 0 4px 6px rgba(255, 255, 255, 1),
        inset 0 -5px 10px rgba(71, 85, 105, 0.85);
      border: 3px solid #f8fafc;
      z-index: 15;
      transform: rotateX(var(--rx)) rotateY(var(--ry));
      transform-style: preserve-3d;
      transition: transform 0.14s ease-out, box-shadow 0.35s ease, border-color 0.35s ease;
    }
    .architectural-frame.frame-combo-1 {
      --glow-color: rgba(56, 189, 248, 0.72);
      border-color: #bae6fd;
    }
    .architectural-frame.frame-combo-2 {
      --glow-color: rgba(251, 191, 36, 0.82);
      border-color: #fde047;
    }
    .architectural-frame.frame-combo-3 {
      --glow-color: rgba(232, 121, 249, 0.95);
      border-color: #f5d0fe;
    }
    .architectural-frame.frame-free-spins {
      --glow-color: rgba(245, 158, 11, 0.92);
      border-color: #fde047;
    }

    /* Top Roof Cornice & Bottom Pedestal */
    .pillar-cap-top {
      position: absolute;
      top: -11px;
      left: -11px;
      right: -11px;
      height: 19px;
      background: linear-gradient(180deg, #ffffff 0%, #e2e8f0 55%, #94a3b8 100%);
      border-radius: 9px;
      border: 2px solid #ffffff;
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.65);
      z-index: 20;
      pointer-events: none;
    }
    .pillar-base-bottom {
      position: absolute;
      bottom: -11px;
      left: -13px;
      right: -13px;
      height: 19px;
      background: linear-gradient(180deg, #f8fafc 0%, #cbd5e1 50%, #64748b 100%);
      border-radius: 9px;
      border: 2px solid #e2e8f0;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.92);
      z-index: 20;
      pointer-events: none;
    }
    /* Fluted Marble Columns Left & Right */
    .architectural-frame::before,
    .architectural-frame::after {
      content: "";
      position: absolute;
      top: 6px;
      bottom: 6px;
      width: 20px;
      border-radius: 6px;
      background: repeating-linear-gradient(
        90deg,
        #ffffff 0px,
        #e2e8f0 3px,
        #94a3b8 5px,
        #f8fafc 8px
      );
      box-shadow: inset 0 2px 4px rgba(255,255,255,0.95), 0 2px 10px rgba(0,0,0,0.45);
      pointer-events: none;
      z-index: 18;
    }
    .architectural-frame::before { left: 3px; }
    .architectural-frame::after { right: 3px; }

    @keyframes boardShake {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      15% { transform: translate(-7px, 5px) rotate(-1deg); }
      35% { transform: translate(7px, -6px) rotate(1deg); }
      55% { transform: translate(-6px, -3px) rotate(-0.7deg); }
      75% { transform: translate(5px, 4px) rotate(0.6deg); }
    }
    .shake-active {
      animation: boardShake 0.44s cubic-bezier(0.36, 0.07, 0.19, 0.97) both !important;
    }

    .board-inner-well {
      background: radial-gradient(circle at 50% 30%, #1e293b 0%, #0f172a 66%, #040711 100%);
      border-radius: 14px;
      padding: 7px;
      border: 3px solid #1e293b;
      box-shadow: inset 0 12px 34px rgba(0, 0, 0, 0.98);
      position: relative;
      z-index: 19;
    }

    /* Combo Chain Meter Bar inside Top of Well */
    .combo-meter-strip {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 4px;
      margin-bottom: 6px;
      padding: 4px 9px;
      border-radius: 9px;
      background: rgba(7, 11, 22, 0.9);
      border: 1px solid rgba(148, 163, 184, 0.22);
    }
    .combo-pip {
      flex: 1;
      height: 5px;
      border-radius: 999px;
      background: rgba(51, 65, 85, 0.65);
      transition: transform 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
    }
    .combo-pip.pip-active-1 {
      background: linear-gradient(90deg, #38bdf8, #06b6d4);
      box-shadow: 0 0 8px #38bdf8;
      transform: scaleY(1.25);
    }
    .combo-pip.pip-active-2 {
      background: linear-gradient(90deg, #fbbf24, #f59e0b);
      box-shadow: 0 0 10px #fbbf24;
      transform: scaleY(1.35);
    }
    .combo-pip.pip-active-3 {
      background: linear-gradient(90deg, #e879f9, #ec4899);
      box-shadow: 0 0 12px #e879f9;
      transform: scaleY(1.45);
    }

    .grid-7x7 {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      grid-template-rows: repeat(7, minmax(0, 1fr));
      gap: 4.5px;
      aspect-ratio: 1 / 1;
      width: 100%;
      margin: 0 auto;
      position: relative;
      z-index: 10;
    }
    @media (max-width: 640px) {
      .architectural-frame {
        padding: 12px 14px 14px 14px;
      }
      .architectural-frame::before,
      .architectural-frame::after {
        width: 9px;
      }
      .grid-7x7 {
        gap: 2.5px;
      }
    }

    /* Pro Max Glossy 3D Symbol Cells with Specular Sheen & Tactile Depth */
    .slot-cell {
      position: relative;
      border-radius: 10px;
      background: linear-gradient(180deg, rgba(36, 50, 74, 0.85) 0%, rgba(15, 23, 42, 0.96) 100%);
      border: 1.5px solid rgba(148, 163, 184, 0.24);
      box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.22), inset 0 -3px 6px rgba(0, 0, 0, 0.65);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      overflow: hidden;
      will-change: transform, opacity;
      transition: border-color 0.16s ease, box-shadow 0.16s ease;
    }
    /* Top Specular Glass Highlight on every cell */
    .slot-cell::before {
      content: "";
      position: absolute;
      top: 0;
      left: 5%;
      right: 5%;
      height: 38%;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 100%);
      border-radius: 8px 8px 50% 50%;
      pointer-events: none;
      z-index: 2;
    }
    .slot-cell:hover {
      border-color: #7dd3fc;
      transform: translateY(-2px) scale(1.07);
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.75), 0 0 15px rgba(56, 189, 248, 0.7) !important;
      z-index: 25;
    }
    .slot-cell.cell-winning {
      border-color: #fde047 !important;
      background: radial-gradient(circle at center, rgba(14, 165, 233, 0.82) 0%, rgba(8, 47, 73, 0.98) 100%) !important;
      box-shadow: 0 0 24px rgba(56, 189, 248, 1), 0 0 12px #fde047, inset 0 0 16px rgba(254, 240, 138, 0.9) !important;
      animation: pulseWin 0.3s ease-in-out infinite alternate;
      z-index: 22;
    }
    .slot-cell.cell-exploding {
      animation: explodeOut 0.24s cubic-bezier(0.6, -0.28, 0.735, 0.045) forwards;
    }
    .slot-cell.cell-dropping {
      animation: dropIn 0.36s cubic-bezier(0.22, 1.38, 0.36, 1) backwards;
    }
    /* Highlighted Blue Koko Multiplier Tile (Matches Reference Screenshot!) */
    .slot-cell.koko-mult-tile {
      background: linear-gradient(180deg, #38bdf8 0%, #0284c7 52%, #0369a1 100%);
      border: 2px solid #e0f2fe;
      box-shadow: 0 4px 16px rgba(2, 132, 199, 0.75), inset 0 2px 6px rgba(255, 255, 255, 0.85);
    }
    .slot-cell.mult-tier-1 {
      background: linear-gradient(180deg, rgba(2, 132, 199, 0.85) 0%, rgba(12, 74, 110, 0.96) 100%);
      border-color: rgba(56, 189, 248, 0.92);
      box-shadow: inset 0 0 12px rgba(56, 189, 248, 0.55);
    }
    .slot-cell.mult-tier-2 {
      background: linear-gradient(180deg, rgba(217, 119, 6, 0.9) 0%, rgba(120, 53, 15, 0.98) 100%);
      border-color: #fde047;
      box-shadow: inset 0 0 14px rgba(251, 191, 36, 0.7);
    }
    .slot-cell.mult-tier-3 {
      background: linear-gradient(180deg, rgba(147, 51, 234, 0.94) 0%, rgba(76, 29, 149, 0.98) 100%);
      border-color: #f472b6;
      box-shadow: 0 0 18px rgba(232, 121, 249, 0.9), inset 0 0 14px rgba(253, 224, 71, 0.7);
    }

    @keyframes pulseWin {
      0% { transform: scale(1.0); }
      100% { transform: scale(1.12); }
    }
    @keyframes explodeOut {
      0% { transform: scale(1.16); opacity: 1; filter: brightness(2.6); }
      100% { transform: scale(0.05) rotate(22deg); opacity: 0; }
    }
    @keyframes dropIn {
      0% { transform: translateY(-60px) scale(0.82, 1.16); opacity: 0; }
      68% { transform: translateY(6px) scale(1.06, 0.94); opacity: 1; }
      85% { transform: translateY(-2px) scale(0.98, 1.02); opacity: 1; }
      100% { transform: translateY(0) scale(1, 1); opacity: 1; }
    }

    /* Reference-style Bold Outlined Multiplier Badge at Bottom of Tile */
    .mult-badge {
      position: absolute;
      bottom: 0px;
      left: 50%;
      transform: translateX(-50%);
      font-family: 'Lilita One', sans-serif;
      font-size: 0.86rem;
      font-weight: 900;
      padding: 0px 4px;
      line-height: 1;
      z-index: 25;
      color: #67e8f9;
      -webkit-text-stroke: 1.3px #082f49;
      text-shadow: 0 2px 3px rgba(0, 0, 0, 0.98), 0 0 8px rgba(34, 211, 238, 0.95);
      pointer-events: none;
    }
    @media (max-width: 640px) {
      .mult-badge {
        font-size: 0.66rem;
      }
    }

    /* RIGHT WING: STANDING 3D PARROT MASCOT WITH NEON PEDESTAL RING & SUNGLASSES GLINT */
    .parrot-stage-column {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      margin-left: -10px;
      padding-bottom: 4px;
      z-index: 24;
      pointer-events: auto;
    }
    @keyframes kokoIdleBreathe {
      0%, 100% { transform: translateY(0px) rotate(0deg) scale(1, 1); }
      50% { transform: translateY(-9px) rotate(-1.6deg) scale(1.025, 0.985); }
    }
    @keyframes kokoSpinWatch {
      0%, 100% { transform: translateX(-8px) rotate(-4deg) scale(1.04); }
      50% { transform: translateX(-12px) translateY(-6px) rotate(-6deg) scale(1.05); }
    }
    @keyframes kokoExcitedJump {
      0% { transform: translateY(0) scale(1) rotate(0deg); }
      20% { transform: translateY(-30px) scale(1.14, 0.9) rotate(-7deg); }
      45% { transform: translateY(-5px) scale(0.94, 1.09) rotate(7deg); }
      70% { transform: translateY(-22px) scale(1.1, 0.95) rotate(-4deg); }
      100% { transform: translateY(0) scale(1) rotate(0deg); }
    }
    .koko-mascot-stand {
      width: clamp(118px, 18.5vw, 230px);
      height: auto;
      animation: kokoIdleBreathe 2.7s ease-in-out infinite;
      transform-origin: bottom center;
      filter: drop-shadow(-8px 16px 24px rgba(0, 0, 0, 0.92));
      cursor: pointer;
      will-change: transform, filter;
      transition: filter 0.25s ease;
    }
    .koko-mascot-stand:hover {
      filter: drop-shadow(0 0 30px rgba(251, 191, 36, 0.88)) brightness(1.1);
    }
    .koko-mascot-watching {
      animation: kokoSpinWatch 0.5s ease-in-out infinite !important;
    }
    .koko-mascot-excited {
      animation: kokoExcitedJump 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 2 !important;
      filter: drop-shadow(0 0 36px rgba(56, 189, 248, 1)) brightness(1.15) !important;
    }

    /* Glowing Floor Pedestal Ring Under Koko's Feet */
    .koko-pedestal-ring {
      width: 84%;
      height: 18px;
      margin-top: -12px;
      border-radius: 9999px;
      background: radial-gradient(ellipse at center, rgba(251, 191, 36, 0.6) 0%, rgba(56, 189, 248, 0.28) 55%, transparent 80%);
      border: 1.5px solid rgba(253, 224, 71, 0.5);
      box-shadow: 0 0 22px rgba(245, 158, 11, 0.6), inset 0 0 10px rgba(56, 189, 248, 0.5);
      animation: pedestalPulse 2.4s ease-in-out infinite alternate;
      pointer-events: none;
    }
    @keyframes pedestalPulse {
      0% { transform: scaleX(0.95); opacity: 0.72; }
      100% { transform: scaleX(1.06); opacity: 1; }
    }

    /* Floating Vector Feather & Music Note Particles Around Parrot */
    @keyframes floatNoteUp {
      0% { transform: translate(0, 0) scale(0.55) rotate(0deg); opacity: 1; }
      100% { transform: translate(var(--tx, 24px), -78px) scale(1.35) rotate(22deg); opacity: 0; }
    }
    .parrot-note-particle {
      position: absolute;
      top: 16%;
      left: 48%;
      width: 24px;
      height: 24px;
      pointer-events: none;
      z-index: 35;
      animation: floatNoteUp 0.95s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    /* LEFT WING: Ornate 3D Game Crest Logo + Live Telemetry Card */
    .left-stage-column {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 6px 8px 6px 0;
      z-index: 22;
    }
    .crest-logo-box {
      background: radial-gradient(ellipse at center, #ffffff 0%, #f1f5f9 58%, #cbd5e1 100%);
      border: 4px solid #ffffff;
      border-radius: 9999px;
      box-shadow:
        0 16px 34px rgba(0, 0, 0, 0.88),
        0 0 24px rgba(56, 189, 248, 0.45),
        inset 0 2px 6px rgba(255,255,255,1);
      padding: 10px 22px;
      text-align: center;
      position: relative;
      transform: rotate(-3deg);
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
      cursor: pointer;
    }
    .crest-logo-box:hover {
      transform: rotate(0deg) scale(1.06);
      box-shadow: 0 18px 38px rgba(0, 0, 0, 0.92), 0 0 32px rgba(251, 191, 36, 0.7);
    }
    .crest-title {
      font-family: 'Lilita One', sans-serif;
      font-weight: 900;
      font-size: clamp(1.15rem, 2.3vw, 1.7rem);
      line-height: 0.92;
      letter-spacing: 0.04em;
      background: linear-gradient(180deg, #0284c7 0%, #38bdf8 48%, #0369a1 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 2px 0px #082f49);
    }

    /* Pro Max Bottom Casino HUD */
    .modes-gold-btn {
      background: linear-gradient(180deg, #fef08a 0%, #f59e0b 52%, #b45309 100%);
      border: 3.5px solid #0f172a;
      outline: 2.5px solid #fbbf24;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.9), 0 0 18px rgba(245, 158, 11, 0.5), inset 0 2px 4px rgba(255, 255, 255, 0.9);
      transition: transform 0.16s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.16s ease;
    }
    .modes-gold-btn:hover {
      transform: translateY(-3px) scale(1.06);
      filter: brightness(1.1);
    }
    .modes-gold-btn:active {
      transform: scale(0.95);
    }

    .hud-dark-bar {
      background: linear-gradient(180deg, rgba(15, 23, 42, 0.95) 0%, rgba(7, 11, 22, 0.98) 100%);
      backdrop-filter: blur(18px);
      border: 1.5px solid rgba(148, 163, 184, 0.3);
      box-shadow: 0 18px 42px rgba(0, 0, 0, 0.95), inset 0 1px 0 rgba(255, 255, 255, 0.14);
    }

    .giant-spin-btn {
      width: 82px;
      height: 82px;
      border-radius: 9999px;
      background: radial-gradient(circle at 35% 28%, #ffffff 0%, #f8fafc 62%, #cbd5e1 100%);
      border: 5px solid #0f172a;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.95), 0 0 0 3px rgba(255,255,255,0.6);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.18s ease;
    }
    .giant-spin-btn:hover:not(:disabled) {
      transform: scale(1.08) rotate(16deg);
      box-shadow: 0 14px 38px rgba(56, 189, 248, 0.8), 0 0 0 3.5px #ffffff;
    }
    .giant-spin-btn:active:not(:disabled) {
      transform: scale(0.92);
    }
    .giant-spin-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
    @keyframes spinIconRotate {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    .spin-icon-active {
      animation: spinIconRotate 0.5s linear infinite;
    }

    /* Priority 7 Accessibility: Respect Reduced Motion */
    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    .custom-scroll::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    .custom-scroll::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.6);
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: rgba(56, 189, 248, 0.5);
      border-radius: 9999px;
    }
  </style>
</head>
<body>

  <div id="stageWrapper" class="stage-wrapper" onmousemove="handleStageMouseMove(event)" onmouseleave="resetStageTilt()">
    <!-- Background Ambient Firefly & Coin Rain Canvas -->
    <canvas id="bgAmbientCanvas" class="pointer-events-none absolute inset-0 w-full h-full z-10"></canvas>
    <div class="stage-vignette"></div>
    <div class="pool-shimmer"></div>

    <!-- TOP STATUS & STUDIO BAR (Matches "16:39 | Private Jet" top-left reference style) -->
    <header class="relative z-30 w-full px-4 py-2 flex flex-wrap items-center justify-between gap-2">
      <!-- Top-Left Clock & Game Title -->
