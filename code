    let audioCtx = null;
    function ensureAudioCtx() {
      if (!state.audioEnabled) return null;
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (!AudioContextClass) return null;
      if (!audioCtx) audioCtx = new AudioContextClass();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    }

    function playReelDropThud(colIndex = 0) {
      const ctx = ensureAudioCtx();
      if (!ctx) return;
      try {
        const now = ctx.currentTime + colIndex * 0.024;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(140 - colIndex * 7, now);
        osc.frequency.exponentialRampToValueAtTime(40, now + 0.065);
        gain.gain.setValueAtTime(0.08, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.07);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.075);
      } catch (e) {}
    }

    function playParrotSound(variant = 'koko_whistle', tumbleStep = 1) {
      const ctx = ensureAudioCtx();
      if (!ctx) return;
      try {
        const now = ctx.currentTime;

        if (variant === 'chirp') {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(1080, now);
          osc.frequency.exponentialRampToValueAtTime(2420, now + 0.055);
          osc.frequency.exponentialRampToValueAtTime(1400, now + 0.11);

          const filter = ctx.createBiquadFilter();
          filter.type = 'bandpass';
          filter.frequency.setValueAtTime(1780, now);
          filter.Q.setValueAtTime(4.2, now);

          gain.gain.setValueAtTime(0.01, now);
          gain.gain.linearRampToValueAtTime(0.16, now + 0.015);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);

          osc.connect(filter);
          filter.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.125);

        } else if (variant === 'koko_whistle') {
          const pitchShift = Math.pow(1.065, Math.min(8, tumbleStep - 1));
          const notes = [
            { start: 0.0, f1: 1180 * pitchShift, f2: 1740 * pitchShift, dur: 0.11 },
            { start: 0.12, f1: 1440 * pitchShift, f2: 2360 * pitchShift, dur: 0.16 }
          ];
          notes.forEach(n => {
            const osc = ctx.createOscillator();
            const lfo = ctx.createOscillator();
            const lfoGain = ctx.createGain();
            const gain = ctx.createGain();

            osc.type = 'triangle';
            osc.frequency.setValueAtTime(n.f1, now + n.start);
            osc.frequency.exponentialRampToValueAtTime(n.f2, now + n.start + n.dur * 0.72);
            osc.frequency.exponentialRampToValueAtTime(n.f1 * 1.15, now + n.start + n.dur);

            lfo.frequency.setValueAtTime(34, now + n.start);
            lfoGain.gain.setValueAtTime(72, now + n.start);
            lfo.connect(lfoGain);
            lfoGain.connect(osc.frequency);

            gain.gain.setValueAtTime(0.001, now + n.start);
            gain.gain.linearRampToValueAtTime(0.18, now + n.start + 0.02);
            gain.gain.exponentialRampToValueAtTime(0.001, now + n.start + n.dur);

            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(now + n.start);
            lfo.start(now + n.start);
            osc.stop(now + n.start + n.dur + 0.01);
            lfo.stop(now + n.start + n.dur + 0.01);
          });

        } else if (variant === 'squawk') {
          const bursts = [
            { offset: 0.0, dur: 0.21, fStart: 820, fPeak: 1950, fEnd: 940 },
            { offset: 0.23, dur: 0.25, fStart: 910, fPeak: 2320, fEnd: 780 }
          ];
          bursts.forEach(b => {
            const t0 = now + b.offset;
            const osc = ctx.createOscillator();
            const lfo = ctx.createOscillator();
            const lfoGain = ctx.createGain();
            const formant = ctx.createBiquadFilter();
            const gain = ctx.createGain();

            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(b.fStart, t0);
            osc.frequency.exponentialRampToValueAtTime(b.fPeak, t0 + b.dur * 0.45);
            osc.frequency.exponentialRampToValueAtTime(b.fEnd, t0 + b.dur);

            lfo.type = 'sine';
            lfo.frequency.setValueAtTime(45, t0);
            lfoGain.gain.setValueAtTime(245, t0);
            lfo.connect(lfoGain);
            lfoGain.connect(osc.frequency);

            formant.type = 'bandpass';
            formant.frequency.setValueAtTime(1520, t0);
            formant.Q.setValueAtTime(3.0, t0);

            gain.gain.setValueAtTime(0.01, t0);
            gain.gain.linearRampToValueAtTime(0.24, t0 + 0.03);
            gain.gain.exponentialRampToValueAtTime(0.001, t0 + b.dur);

            osc.connect(formant);
            formant.connect(gain);
            gain.connect(ctx.destination);

            osc.start(t0);
            lfo.start(t0);
            osc.stop(t0 + b.dur + 0.01);
            lfo.stop(t0 + b.dur + 0.01);
          });
        }
      } catch (e) {}
    }

