    function formatCurrency(val) {
      const num = Number(val) || 0;
      if (state.socialMode) {
        return num.toFixed(2) + ' COINS';
      }
      return '$' + num.toFixed(2);
    }

    let winAnimFrame = null;
    function animateWinReadout(targetVal) {
      const el = document.getElementById('hudWinValue');
      if (!el) return;
      if (winAnimFrame) cancelAnimationFrame(winAnimFrame);
      const startVal = state.displayedWin || 0;
      const startTime = performance.now();
      const duration = 320;

      function tick(now) {
        const p = Math.min(1, (now - startTime) / duration);
        const eased = 1 - Math.pow(1 - p, 3);
        const cur = startVal + (targetVal - startVal) * eased;
        state.displayedWin = cur;
        el.textContent = formatCurrency(cur);
        if (p < 1) {
          winAnimFrame = requestAnimationFrame(tick);
        } else {
          state.displayedWin = targetVal;
          el.textContent = formatCurrency(targetVal);
        }
      }
      winAnimFrame = requestAnimationFrame(tick);
    }

    function updateComboMeterUI(tumbleStep) {
      const frame = document.getElementById('boardFrameContainer');
      const statusEl = document.getElementById('comboChainStatus');
      for (let i = 1; i <= 4; i++) {
        const pip = document.getElementById('comboPip' + i);
        if (!pip) continue;
        pip.className = 'combo-pip';
        if (tumbleStep >= i) {
          pip.classList.add(tumbleStep >= 3 ? 'pip-active-3' : tumbleStep === 2 ? 'pip-active-2' : 'pip-active-1');
