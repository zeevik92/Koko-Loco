    function startAmbientStageLoop() {
      const canvas = document.getElementById('bgAmbientCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');

      function frame(ts) {
        if (canvas.width !== window.innerWidth || canvas.height !== window.innerHeight) {
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
        }
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        ambientEmbers.forEach(e => {
          e.y -= e.vy;
          e.x += e.vx;
          if (e.y < -0.05) { e.y = 1.05; e.x = Math.random(); }
          const alpha = 0.25 + 0.35 * Math.sin(ts * 0.003 + e.phase);
          ctx.save();
          ctx.globalAlpha = Math.max(0.05, alpha);
          ctx.fillStyle = '#fde047';
          ctx.beginPath();
          ctx.arc(e.x * canvas.width, e.y * canvas.height, e.r, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        });

        for (let i = stageCoins.length - 1; i >= 0; i--) {
          const c = stageCoins[i];
          c.x += c.vx;
          c.y += c.vy;
          c.vy += 0.32;
          c.spin += c.vSpin;
          if (c.y > canvas.height + 20) {
            stageCoins.splice(i, 1);
            continue;
          }
          const rx = Math.max(1.5, Math.abs(Math.cos(c.spin)) * c.r);
          ctx.save();
          ctx.fillStyle = '#fbbf24';
          ctx.strokeStyle = '#fef08a';
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.ellipse(c.x, c.y, rx, c.r, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
          ctx.restore();
        }

        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    }

